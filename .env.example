# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
# Optional ViLao configuration. When AI_PROVIDER is set, AI_* takes precedence.
# AI_PROVIDER=openai
# AI_API_KEY=your_vilao_api_key_here
# AI_BASE_URL=https://api.vilao.ai/v1
# AI_MODEL=rk/llms/gemini-3.1-flash-lite
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional: set LLM_PROVIDER=openai to use the original lab provider.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
